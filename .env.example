# --- OpenAI (a chave fica só no backend) ---
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
# Identificador da loja (não da pessoa) enviado como OpenAI-Safety-Identifier
OPENAI_SAFETY_ID=iara-loja

# --- Vídeo: none | webcam | rtsp | file ---
VIDEO_SOURCE=webcam
WEBCAM_INDEX=0
# any | dshow | msmf | v4l2  (no Windows, dshow costuma abrir mais rápido)
WEBCAM_BACKEND=any

# RTSP (produção). Ou preencha RTSP_URL inteira, ou os campos separados.
# Mercusys MC210 / Tapo C500: rtsp://usuario:senha@IP:554/stream1 (2K) ou /stream2 (baixa)
RTSP_URL=
RTSP_HOST=192.168.0.50
RTSP_PORT=554
RTSP_USER=
RTSP_PASSWORD=
RTSP_PATH=stream2

# Arquivo de vídeo simulando o stream (VIDEO_SOURCE=file)
VIDEO_FILE=

DETECTION_FPS=2
DETECTOR_MODEL=models/yolox_nano.onnx

# --- Áudio: full (conversa simultânea) | half (walkie-talkie: muta o mic enquanto a IA fala) ---
AUDIO_DUPLEX=full

# --- Servidor ---
HOST=127.0.0.1
PORT=8000
CONFIG_FILE=config.yaml
LOG_LEVEL=INFO
